# ---- Model / training hyperparameters ----
MODEL_NAME=bert-base-uncased
NUM_LABELS=3
MAX_LENGTH=128
BATCH_SIZE=16
LEARNING_RATE=2e-5
NUM_EPOCHS=3
WARMUP_STEPS=500
WEIGHT_DECAY=0.01

# ---- Paths (relative paths resolve to the project root) ----
DATA_DIR=data
MODEL_DIR=models
TWITTER_CSV=data/raw/twitter.csv

# ---- Monitoring / misc ----
WANDB_PROJECT=sentiment-engine
# Set REPORT_TO=wandb to enable Weights & Biases logging during training.
REPORT_TO=none
LOG_LEVEL=INFO
