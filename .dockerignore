# Version control
.git
.gitignore

# Python caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environments
.env
.venv/
venv/
env/

# Data & artifacts (mounted at runtime, not baked into image)
data/raw/*
data/processed/*
models/*
reports/*

# Notebooks & docs not needed in the image
notebooks/
*.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
